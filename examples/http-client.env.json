{
  "$shared": {
    "BASE_URL": "https://httpbin.org",
    "$default_headers": {
      "X-Shared-Source": "http-client.env.json",
      "Accept": "application/json"
    }
  },
  "dev": {
    "ENV_NAME": "development",
    "API_HOST": "https://httpbin.org",
    "TIMEOUT": "10",
    "$default_headers": {
      "X-Environment": "dev"
    }
  },
  "staging": {
    "ENV_NAME": "staging",
    "API_HOST": "https://staging.example.com",
    "TIMEOUT": "15",
    "$default_headers": {
      "X-Environment": "staging"
    }
  },
  "prod": {
    "ENV_NAME": "production",
    "API_HOST": "https://api.example.com",
    "TIMEOUT": "5",
    "$default_headers": {
      "X-Environment": "prod"
    }
  }
}
